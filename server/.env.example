# ============================================================
# TEEROP POS -- Server Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (single connection string) ---
# Local:      postgres://postgres:yourpassword@localhost:5432/teerop_pos
# Render:     provided automatically as DATABASE_URL
DATABASE_URL=postgres://user:password@localhost:5432/teerop_pos

# --- JWT (used in Phase 3) ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# --- File Upload ---
UPLOAD_DIR=uploads
