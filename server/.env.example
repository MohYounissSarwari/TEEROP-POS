# ============================================================
# TEEROP POS -- Server Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Do NOT commit the real .env file to GitHub.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (individual fields for local development) ---
DB_NAME=teerop_pos
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# --- Database (connection string for Render production) ---
# DATABASE_URL=postgres://user:password@host:5432/teerop_pos

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# --- File Upload ---
UPLOAD_DIR=uploads
